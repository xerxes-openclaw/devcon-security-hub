# Copy to .env and fill in. SECRET_KEY is generated on first run if missing.
# SECRET_KEY=

# --- public deploy ---
SITE_URL=https://security-hub.example.org
COOKIE_SECURE=1
TRUST_PROXY=1
BIND_HOST=127.0.0.1
# PORT=4590

# --- content placeholders (shown on the public page) ---
# Telegram invite link; the hero button stays "coming soon" while blank.
TELEGRAM_URL=
# Floor/room once Devcon assigns it.
HUB_LOCATION=Floor and room to be announced
# Shown to hosts on the shifts page.
HANDOVER_NOTE=Hosts arrive 15 to 30 minutes before their shift for the handover.
